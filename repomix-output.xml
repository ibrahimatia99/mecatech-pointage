    font-weight: 600;
    cursor: pointer;
  }
  .error-msg {
    color: #ef4444;
    font-size: 13px;
    margin-bottom: 10px;
  }
</style>
{% endblock %}

{% block layout %}
<div class="login-card">
  <h2>{{ cfg.app_name }}</h2>
  <p style="color:#8e8ba7; font-size:14px; margin-top:5px;">Enter administrative password</p>
  
  <form method="POST" action="{{ url_for('auth.login') }}" style="margin-top:20px;">
    {% if error %}
      <div class="error-msg">{{ error }}</div>
    {% endif %}
    <input type="password" name="password" placeholder="Password" required autofocus>
    <button type="submit">Sign In</button>
  </form>
</div>
{% endblock %}
</file>

